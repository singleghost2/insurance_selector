# 大模型配置：任意 OpenAI 兼容供应商均可
# 通义千问 DashScope 兼容模式（默认推荐）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-你的key
LLM_TEXT_MODEL=qwen-plus
LLM_VISION_MODEL=qwen-vl-max

# DeepSeek 示例（无视觉模型，健康档案图片解析不可用）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_TEXT_MODEL=deepseek-chat

# 智谱 GLM 示例
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_TEXT_MODEL=glm-4-air
# LLM_VISION_MODEL=glm-4v-flash

# OCR 引擎，用于扫描版 PDF、蚂蚁保图片条款、体检报告照片的文字识别：
#   paddle_api = PaddleOCR 官方云端 API（默认，质量最好；到 aistudio.baidu.com 获取 token）
#   paddle     = 本地 PaddleOCR（免费离线，需 pip install paddlepaddle paddleocr）
#   vision     = 视觉大模型（需要供应商有视觉模型，DeepSeek 不支持）
OCR_ENGINE=paddle_api
PADDLE_OCR_API_TOKEN=你的token

# 单次 LLM 请求超时（秒）
LLM_TIMEOUT=300
# 供应商是否支持 response_format={"type":"json_object"}；不支持则设为 false，走提示词约束
LLM_JSON_MODE=true
